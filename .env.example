# Buscas públicas no Same Energy não exigem login nem API key.
# Pasta compartilhada para imagens de entrada e downloads; use caminho absoluto.
# O instalador preenche este campo a partir de --workspace.
SAME_ENERGY_WORKSPACE_DIR=

# Catálogo local, acessível somente neste computador. Altere se a porta estiver ocupada.
SAME_ENERGY_CATALOG_PORT=8765

# O instalador acrescenta SAME_ENERGY_INSTALL_DIRECTORY com a pasta do checkout.
# Esse caminho permite ao agente executar o atualizador local após aprovação.
