{
  "schema_version": 4,
  "large_images_only": true,
  "minimum_long_edge": 1280,
  "minimum_short_edge": 720,
  "ask_output_directory_per_search": true,
  "output_folder_template": "output_{date}_{search_name}",
  "date_format": "%Y-%m-%d",
  "timezone": "America/Sao_Paulo",
  "metadata_subdirectory": "json",
  "photographs_only": true,
  "reject_markings": true,
  "reject_clearly_ai_generated": true,
  "require_visual_review_before_save": true,
  "catalog_after_save": true,
  "guided_task_on_start": true
}
